{
  "ReverseProxy": {
    "Routes": {
      "vite": {
        "ClusterId": "vite",
        "Match": { "Path": "/{**catch-all}" }
      }
    },
    "Clusters": {
      "user-service": {
        "Destinations": {
          "primary": { "Address": "http://localhost:8080/" }
        }
      },
      "vite": {
        "Destinations": {
          "primary": { "Address": "http://127.0.0.1:5173/" }
        }
      }
    }
  }
}
