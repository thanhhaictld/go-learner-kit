{
  "Authentication": {
    "Authority": "http://localhost:8081",
    "ClientId": "saas-admin-portal-bff",
    "RequireHttpsMetadata": false,
    "BackchannelAuthority": ""
  },
  "ReverseProxy": {
    "Routes": {
      "users": {
        "ClusterId": "user-service",
        "AuthorizationPolicy": "portal-user",
        "Match": { "Path": "/api/users/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/api" }]
      }
    },
    "Clusters": {
      "user-service": {
        "Destinations": {
          "primary": { "Address": "http://user-service:8080/" }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Yarp": "Warning" }
  }
}
