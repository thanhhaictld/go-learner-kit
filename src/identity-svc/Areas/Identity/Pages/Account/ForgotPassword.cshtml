@page
@model Identity.Svc.Areas.Identity.Pages.Account.ForgotPasswordModel
@{ ViewData["Title"] = "Forgot password"; }
<div class="min-h-screen bg-slate-100 px-4 py-12"><section class="mx-auto max-w-md rounded-lg bg-white p-8 shadow-lg"><h1 class="text-2xl font-bold">Reset your password</h1><p class="mt-2 text-gray-600">Enter your email and we will send reset instructions.</p><form method="post" class="mt-5"><label asp-for="Input.Email">Email</label><input class="mt-1 block w-full rounded border p-2" asp-for="Input.Email" autocomplete="email" /><span asp-validation-for="Input.Email" class="text-sm text-red-600"></span><button class="mt-4 rounded bg-slate-800 px-4 py-2 text-white">Send reset link</button></form></section></div>
