@page
@model Identity.Svc.Areas.Identity.Pages.Account.LoginWith2faModel
@{ ViewData["Title"] = "Verify your sign-in"; }
<div class="min-h-screen bg-slate-100 px-4 py-12"><section class="mx-auto max-w-md rounded-lg bg-white p-8 shadow-lg"><h1 class="text-2xl font-bold">Verify your sign-in</h1><p class="mt-2 text-gray-600">Enter the code from your authenticator app.</p><form method="post" class="mt-5"><label asp-for="Input.Code">Authenticator code</label><input class="mt-1 block w-full rounded border p-2" asp-for="Input.Code" autocomplete="one-time-code" inputmode="numeric" /><span asp-validation-for="Input.Code" class="text-sm text-red-600"></span><label class="mt-4 flex gap-2"><input asp-for="Input.RememberMachine" /> Remember this browser</label><div asp-validation-summary="ModelOnly" class="mt-3 text-sm text-red-600"></div><button class="mt-4 rounded bg-slate-800 px-4 py-2 text-white">Verify</button></form><a class="mt-4 inline-block text-sm text-blue-600" asp-page="LoginWithRecoveryCode">Use a recovery code</a></section></div>
