@model Identity.Svc.Areas.Identity.Pages.Account.LoginWithRecoveryCodeModel
@{ ViewData["Title"] = "Recovery code"; }
<div class="min-h-screen bg-slate-100 px-4 py-12"><section class="mx-auto max-w-md rounded-lg bg-white p-8 shadow-lg"><h1 class="text-2xl font-bold">Use a recovery code</h1><form method="post" class="mt-5"><label asp-for="Input.RecoveryCode">Recovery code</label><input class="mt-1 block w-full rounded border p-2" asp-for="Input.RecoveryCode" autocomplete="one-time-code" /><div asp-validation-summary="ModelOnly" class="mt-3 text-sm text-red-600"></div><button class="mt-4 rounded bg-slate-800 px-4 py-2 text-white">Sign in</button></form></section></div>
