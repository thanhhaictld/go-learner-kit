@page
@model Identity.Svc.Areas.Identity.Pages.Account.Manage.IndexModel
@{ ViewData["Title"] = "My account"; }
<div class="min-h-screen bg-slate-100 px-4 py-12"><section class="mx-auto max-w-2xl rounded-lg bg-white p-8 shadow-lg"><div class="flex items-center justify-between"><div><p class="text-sm font-semibold uppercase tracking-wide text-blue-600">My account</p><h1 class="text-2xl font-bold">Profile and security</h1></div><a class="text-sm text-blue-600" href="/connect/logout">Sign out</a></div><form method="post" class="mt-8 border-b pb-8"><h2 class="font-semibold">Profile</h2><label class="mt-4 block" asp-for="Input.DisplayName">Name</label><input class="mt-1 block w-full rounded border p-2" asp-for="Input.DisplayName" autocomplete="name" /><span asp-validation-for="Input.DisplayName" class="text-sm text-red-600"></span><p class="mt-4 text-sm text-gray-600">Email: @User.Identity?.Name</p><button class="mt-4 rounded bg-slate-800 px-4 py-2 text-white">Save name</button></form><section class="mt-8"><h2 class="font-semibold">Security</h2><a class="mt-3 inline-block text-blue-600" asp-page="../SetupAuthenticator">Set up or manage MFA</a></section><section class="mt-8"><h2 class="font-semibold">Joined organizations</h2><ul class="mt-3 divide-y rounded border">@foreach (var membership in Model.Memberships) { <li class="flex items-center justify-between p-3"><span>@membership.Organization.Name <small class="block text-gray-500">Joined @membership.JoinedAt.ToString("yyyy-MM-dd")</small></span><a class="text-sm text-blue-600" asp-page="../OrganizationSettings" asp-route-organizationId="@membership.OrganizationId">Settings</a></li> }</ul></section></section></div>
