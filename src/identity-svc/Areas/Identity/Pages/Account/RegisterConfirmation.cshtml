@page
@model Identity.Svc.Areas.Identity.Pages.Account.RegisterConfirmationModel
@{ ViewData["Title"] = "Confirm your email"; }
<div class="min-h-screen bg-slate-100 px-4 py-12"><section class="mx-auto max-w-md rounded-lg bg-white p-8 shadow-lg"><h1 class="text-2xl font-bold">Check your inbox</h1><p class="mt-3 text-gray-600">We sent a confirmation link to @Model.Email. Confirm your email before signing in.</p><a class="mt-6 inline-block text-blue-600" asp-page="ResendEmailConfirmation">Resend confirmation email</a></section></div>
