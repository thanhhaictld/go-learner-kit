@page
@model Identity.Svc.Areas.Identity.Pages.Account.ResendEmailConfirmationModel
@{ ViewData["Title"] = "Resend confirmation"; }
<div class="min-h-screen bg-slate-100 px-4 py-12"><section class="mx-auto max-w-md rounded-lg bg-white p-8 shadow-lg"><h1 class="text-2xl font-bold">Resend confirmation</h1>@if (Model.Sent) { <p class="mt-3 text-gray-600">If an unconfirmed account exists, we sent a confirmation email.</p> } else { <form method="post" class="mt-5"><label asp-for="Input.Email">Email</label><input class="mt-1 block w-full rounded border p-2" asp-for="Input.Email" autocomplete="email" /><span asp-validation-for="Input.Email" class="text-sm text-red-600"></span><button class="mt-4 rounded bg-slate-800 px-4 py-2 text-white">Send email</button></form> }</section></div>
