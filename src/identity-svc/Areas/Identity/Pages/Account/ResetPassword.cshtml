@page
@model Identity.Svc.Areas.Identity.Pages.Account.ResetPasswordModel
@{ ViewData["Title"] = "Choose a new password"; }
<div class="min-h-screen bg-slate-100 px-4 py-12"><section class="mx-auto max-w-md rounded-lg bg-white p-8 shadow-lg"><h1 class="text-2xl font-bold">Choose a new password</h1><form method="post" class="mt-5"><input type="hidden" asp-for="Input.Code" /><label asp-for="Input.Email">Email</label><input class="mt-1 block w-full rounded border p-2" asp-for="Input.Email" autocomplete="email" /><label class="mt-3 block" asp-for="Input.Password">New password</label><input class="mt-1 block w-full rounded border p-2" asp-for="Input.Password" autocomplete="new-password" /><label class="mt-3 block" asp-for="Input.ConfirmPassword">Confirm password</label><input class="mt-1 block w-full rounded border p-2" asp-for="Input.ConfirmPassword" autocomplete="new-password" /><div asp-validation-summary="ModelOnly" class="mt-3 text-sm text-red-600"></div><button class="mt-4 rounded bg-slate-800 px-4 py-2 text-white">Reset password</button></form></section></div>
