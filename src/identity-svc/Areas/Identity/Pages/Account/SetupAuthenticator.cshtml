@page
@model Identity.Svc.Areas.Identity.Pages.Account.SetupAuthenticatorModel
@{ ViewData["Title"] = "Set up MFA"; }
<div class="min-h-screen bg-slate-100 px-4 py-12"><section class="mx-auto max-w-md rounded-lg bg-white p-8 shadow-lg"><h1 class="text-2xl font-bold">Set up authenticator MFA</h1>@if (Model.RecoveryCodes.Count > 0) { <p class="mt-3 text-gray-600">Save these recovery codes now. They will not be shown again.</p><ul class="mt-4 grid grid-cols-2 gap-2 rounded bg-slate-100 p-4 font-mono text-sm">@foreach (var code in Model.RecoveryCodes) { <li>@code</li> }</ul><a class="mt-5 inline-block text-blue-600" asp-page="Manage/Index">Continue to my account</a> } else { <p class="mt-2 text-gray-600">Scan this code with your authenticator app, then enter its six-digit code.</p><img class="mt-5 h-48 w-48" src="@Model.QrCodeDataUrl" alt="Authenticator setup QR code" /><p class="mt-4 break-all font-mono text-sm">@Model.SharedKey</p><form method="post" class="mt-5"><label asp-for="Code">Verification code</label><input class="mt-1 block w-full rounded border p-2" asp-for="Code" autocomplete="one-time-code" inputmode="numeric" /><div asp-validation-summary="ModelOnly" class="mt-3 text-sm text-red-600"></div><button class="mt-4 rounded bg-slate-800 px-4 py-2 text-white">Enable MFA</button></form> }</section></div>
