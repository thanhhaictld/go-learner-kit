###
# @name create_user
# @ref setup
POST {{BASE_URL}}/users
Content-Type: application/json
X-User-ID: {{USER_ID}}
X-Organization-ID: {{ORGANIZATION_ID}}
{
    "name": "John Doe {{$randomInt}}",
    "email": "john.doe{{$randomInt}}@example.com"
}
{{
    console.log("Response: ", response.parsedBody)
    exports.userId = response.parsedBody.id
}}


###
# @name get_user
# @ref create_user
GET {{BASE_URL}}/users/{{userId}}
X-User-ID: {{USER_ID}}
X-Organization-ID: {{ORGANIZATION_ID}}


###
# @name get_users
GET {{BASE_URL}}/users
X-User-ID: {{USER_ID}}
X-Organization-ID: {{ORGANIZATION_ID}}
